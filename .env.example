APP_NAME="Inhutani Land Management"
APP_ENV=production
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# Railway env vars override this; relative path works because start.sh runs from project root
DB_DATABASE=database/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="inhutani@land-management.com"
MAIL_FROM_NAME="${APP_NAME}"
